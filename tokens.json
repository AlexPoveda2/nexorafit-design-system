{
  "name": "Nexora Fit",
  "version": 1,
  "meta": {
    "description": "Única fuente de los tokens de Nexora Fit. scripts/tokens.mjs genera tokens.css, el bloque de nexora-fit y los archivos del visor.",
    "consumer": "nexora-fit · src/app/globals.css (Tailwind CSS v4 + shadcn/ui)",
    "sources": {
      "nexora": "Token propio de Nexora: se emite en el bloque de globals.css de nexora-fit.",
      "tailwind": "Valor por defecto de Tailwind CSS v4 que Nexora adopta tal cual: se documenta y se usa en el visor, pero no se emite en globals.css."
    }
  },
  "palette": {
    "source": "nexora",
    "tokens": [
      { "name": "negro", "value": "#0b0b0b", "usage": "Fondo del tema oscuro y texto del tema claro." },
      { "name": "carbon", "value": "#161616", "usage": "Tarjetas y superficies sobre negro." },
      { "name": "grafito", "value": "#2a2a2a", "usage": "Bordes decorativos y separadores en oscuro." },
      { "name": "blanco", "value": "#ffffff", "usage": "Fondo del tema claro y texto del tema oscuro." },
      { "name": "humo", "value": "#f5f5f5", "usage": "Superficies suaves en claro: secciones alternas, filas de tabla, `muted`." },
      { "name": "niebla", "value": "#e5e5e5", "usage": "Bordes decorativos y separadores en claro." },
      { "name": "gris", "value": "#8a8a8a", "usage": "Texto secundario en oscuro y borde de los campos en los dos temas. No pasa AA como texto sobre blanco." },
      { "name": "acero", "value": "#6b6b6b", "usage": "Texto secundario en claro (5,33:1 sobre blanco)." },
      { "name": "rojo", "value": "#e10600", "usage": "Botones de compra, precios en claro y la sección del pack." },
      { "name": "rojo-oscuro", "value": "#b80500", "usage": "Hover y estado presionado de los botones rojos." },
      { "name": "rojo-vivo", "value": "#ff3b30", "usage": "Precios y texto rojo sobre fondo oscuro (el rojo base no pasa AA ahí)." }
    ]
  },
  "color": {
    "source": "nexora",
    "default": "light",
    "themes": [
      { "id": "light", "name": "Claro", "selector": ":root" },
      { "id": "dark", "name": "Oscuro", "selector": ".dark" }
    ],
    "tokens": [
      { "name": "background", "group": "Base (shadcn/ui)", "value": { "light": "{blanco}", "dark": "{negro}" }, "usage": "Fondo de página o sección." },
      { "name": "foreground", "group": "Base (shadcn/ui)", "value": { "light": "{negro}", "dark": "{blanco}" }, "usage": "Texto principal." },
      { "name": "card", "group": "Base (shadcn/ui)", "value": { "light": "{blanco}", "dark": "{carbon}" }, "usage": "Tarjetas." },
      { "name": "card-foreground", "group": "Base (shadcn/ui)", "value": { "light": "{negro}", "dark": "{blanco}" }, "usage": "Texto sobre `card`." },
      { "name": "popover", "group": "Base (shadcn/ui)", "value": { "light": "{blanco}", "dark": "{carbon}" }, "usage": "Menús, diálogos, `Sheet` y avisos." },
      { "name": "popover-foreground", "group": "Base (shadcn/ui)", "value": { "light": "{negro}", "dark": "{blanco}" }, "usage": "Texto sobre `popover`." },
      { "name": "primary", "group": "Base (shadcn/ui)", "value": { "light": "{negro}", "dark": "{blanco}" }, "usage": "Acción principal que no vende, casillas marcadas, barras de progreso, pestaña activa. Nunca rojo." },
      { "name": "primary-foreground", "group": "Base (shadcn/ui)", "value": { "light": "{blanco}", "dark": "{negro}" }, "usage": "Texto sobre `primary`." },
      { "name": "secondary", "group": "Base (shadcn/ui)", "value": { "light": "{humo}", "dark": "{grafito}" }, "usage": "Botón secundario." },
      { "name": "secondary-foreground", "group": "Base (shadcn/ui)", "value": { "light": "{negro}", "dark": "{blanco}" }, "usage": "Texto sobre `secondary`." },
      { "name": "muted", "group": "Base (shadcn/ui)", "value": { "light": "{humo}", "dark": "{carbon}" }, "usage": "Superficies secundarias y esqueletos." },
      { "name": "muted-foreground", "group": "Base (shadcn/ui)", "value": { "light": "{acero}", "dark": "{gris}" }, "usage": "Texto secundario, ayudas y metadatos." },
      { "name": "accent", "group": "Base (shadcn/ui)", "value": { "light": "{humo}", "dark": "{grafito}" }, "usage": "Hover de menús, botones `outline` y `ghost`." },
      { "name": "accent-foreground", "group": "Base (shadcn/ui)", "value": { "light": "{negro}", "dark": "{blanco}" }, "usage": "Texto sobre `accent`." },
      { "name": "border", "group": "Base (shadcn/ui)", "value": { "light": "{niebla}", "dark": "{grafito}" }, "usage": "Bordes decorativos: tarjetas, separadores, tablas. Nunca el único borde de un control." },
      { "name": "input", "group": "Base (shadcn/ui)", "value": { "light": "{gris}", "dark": "{gris}" }, "usage": "Borde de campos, casillas, radios y botones `outline` (≥ 3:1)." },
      { "name": "ring", "group": "Base (shadcn/ui)", "value": { "light": "{negro}", "dark": "{blanco}" }, "usage": "Anillo de foco." },
      { "name": "cta", "group": "Venta", "value": { "light": "{rojo}", "dark": "{rojo}" }, "usage": "Fondo de los botones de compra y de la sección del pack. Uno por bloque visible." },
      { "name": "cta-hover", "group": "Venta", "value": { "light": "{rojo-oscuro}", "dark": "{rojo-oscuro}" }, "usage": "Hover y presionado del `cta`." },
      { "name": "cta-foreground", "group": "Venta", "value": { "light": "{blanco}", "dark": "{blanco}" }, "usage": "Texto sobre `cta`." },
      { "name": "price", "group": "Venta", "value": { "light": "{rojo}", "dark": "{rojo-vivo}" }, "usage": "Precio vigente como texto." },
      { "name": "destructive", "group": "Estados", "value": { "light": "#b42318", "dark": "#b42318" }, "usage": "Fondo de botones destructivos (anular, borrar), solo dentro de un `AlertDialog`. Texto blanco encima." },
      { "name": "danger", "group": "Estados", "value": { "light": "#b42318", "dark": "#f87171" }, "usage": "Texto e ícono de error; siempre con `CircleAlert` y texto." },
      { "name": "success", "group": "Estados", "value": { "light": "#15803d", "dark": "#4ade80" }, "usage": "Texto e ícono de éxito (aprobado, día completado)." },
      { "name": "warning", "group": "Estados", "value": { "light": "#b45309", "dark": "#fbbf24" }, "usage": "Texto e ícono de aviso (pendiente, por vencer)." }
    ],
    "contrast": [
      { "fg": "foreground", "bg": "background", "theme": "light", "min": 4.5, "usage": "Texto principal en claro" },
      { "fg": "foreground", "bg": "card", "theme": "dark", "min": 4.5, "usage": "Texto principal sobre tarjeta oscura" },
      { "fg": "primary-foreground", "bg": "primary", "theme": "light", "min": 4.5, "usage": "Botón `default` en claro" },
      { "fg": "primary-foreground", "bg": "primary", "theme": "dark", "min": 4.5, "usage": "Botón `default` en oscuro" },
      { "fg": "cta-foreground", "bg": "cta", "theme": "light", "min": 4.5, "usage": "Botón `cta`" },
      { "fg": "cta-foreground", "bg": "cta-hover", "theme": "light", "min": 4.5, "usage": "Botón `cta` en hover" },
      { "fg": "price", "bg": "background", "theme": "light", "min": 4.5, "usage": "Precio en claro" },
      { "fg": "price", "bg": "background", "theme": "dark", "min": 4.5, "usage": "Precio sobre negro (`rojo-vivo`)" },
      { "fg": "price", "bg": "card", "theme": "dark", "min": 4.5, "usage": "Precio sobre tarjeta oscura" },
      { "fg": "muted-foreground", "bg": "background", "theme": "light", "min": 4.5, "usage": "Texto secundario en claro" },
      { "fg": "muted-foreground", "bg": "muted", "theme": "light", "min": 4.5, "usage": "Texto secundario sobre `muted` en claro" },
      { "fg": "muted-foreground", "bg": "background", "theme": "dark", "min": 4.5, "usage": "Texto secundario en oscuro" },
      { "fg": "muted-foreground", "bg": "card", "theme": "dark", "min": 4.5, "usage": "Texto secundario sobre tarjeta oscura" },
      { "fg": "input", "bg": "background", "theme": "light", "min": 3, "usage": "Borde de campo en claro" },
      { "fg": "input", "bg": "muted", "theme": "light", "min": 3, "usage": "Borde de campo sobre `muted`" },
      { "fg": "input", "bg": "background", "theme": "dark", "min": 3, "usage": "Borde de campo en oscuro" },
      { "fg": "ring", "bg": "background", "theme": "light", "min": 3, "usage": "Foco en claro" },
      { "fg": "ring", "bg": "card", "theme": "dark", "min": 3, "usage": "Foco en oscuro" },
      { "fg": "#ffffff", "bg": "destructive", "theme": "light", "min": 4.5, "usage": "Botón `destructive` (texto blanco)" },
      { "fg": "danger", "bg": "background", "theme": "light", "min": 4.5, "usage": "Error en claro" },
      { "fg": "success", "bg": "background", "theme": "light", "min": 4.5, "usage": "Éxito en claro" },
      { "fg": "warning", "bg": "background", "theme": "light", "min": 4.5, "usage": "Aviso en claro" },
      { "fg": "danger", "bg": "card", "theme": "dark", "min": 4.5, "usage": "Error sobre tarjeta oscura" },
      { "fg": "success", "bg": "card", "theme": "dark", "min": 4.5, "usage": "Éxito sobre tarjeta oscura" },
      { "fg": "warning", "bg": "card", "theme": "dark", "min": 4.5, "usage": "Aviso sobre tarjeta oscura" },
      { "fg": "{rojo}", "bg": "{negro}", "min": 3, "usage": "Rojo base sobre negro: solo texto grande (≥ 24 px). Para texto normal, `price` (`rojo-vivo`)." }
    ]
  },
  "type": {
    "families": [
      { "name": "display", "family": "Bebas Neue", "nextFont": "--font-bebas-neue", "stack": "\"Bebas Neue\", Impact, \"Arial Narrow\", sans-serif", "weights": [400], "usage": "Títulos de página y de sección, nombres de deporte, precios grandes. Mínimo 24 px, nunca en negrita, párrafos, botones, campos ni tablas." },
      { "name": "sans", "family": "Inter", "nextFont": "--font-inter", "stack": "Inter, ui-sans-serif, system-ui, \"Segoe UI\", Roboto, Arial, sans-serif", "weights": [400, 500, 600, 700], "usage": "Todo lo demás: párrafos, botones, formularios, tablas, panel." },
      { "name": "mono", "stack": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace", "usage": "Código de acceso, IDs de video y referencias de orden." }
    ],
    "fonts": [
      { "family": "Bebas Neue", "file": "fonts/bebas-neue-latin.woff2", "weight": "400", "style": "normal", "license": "fonts/OFL-bebas-neue.txt" },
      { "family": "Inter", "file": "fonts/inter-latin.woff2", "weight": "100 900", "style": "normal", "license": "fonts/OFL-inter.txt" }
    ],
    "scale": [
      { "name": "hero", "source": "nexora", "family": "display", "size": "clamp(3rem, 1.8rem + 5.3vw, 6rem)", "lineHeight": "0.95", "range": "48 → 96 px", "usage": "Título del hero." },
      { "name": "display-1", "source": "nexora", "family": "display", "size": "clamp(2.5rem, 1.9rem + 2.6vw, 4rem)", "lineHeight": "1", "range": "40 → 64 px", "usage": "Título de página (deporte, «Mis planes»)." },
      { "name": "display-2", "source": "nexora", "family": "display", "size": "clamp(2rem, 1.6rem + 1.75vw, 3rem)", "lineHeight": "1", "range": "32 → 48 px", "usage": "Título de sección." },
      { "name": "display-3", "source": "nexora", "family": "display", "size": "clamp(1.5rem, 1.3rem + 0.9vw, 2rem)", "lineHeight": "1.1", "range": "24 → 32 px", "usage": "Título de tarjeta (nombre del deporte)." },
      { "name": "price-lg", "source": "nexora", "family": "display", "size": "clamp(2.5rem, 2.1rem + 1.75vw, 3.5rem)", "lineHeight": "1", "range": "40 → 56 px", "usage": "Precio en la página del deporte, el pack y el checkout." },
      { "name": "xl", "source": "tailwind", "family": "sans", "weight": 600, "size": "1.25rem", "lineHeight": "calc(1.75 / 1.25)", "range": "20 px", "usage": "Título de bloque, título de pantalla del panel." },
      { "name": "lg", "source": "tailwind", "family": "sans", "weight": 400, "size": "1.125rem", "lineHeight": "calc(1.75 / 1.125)", "range": "18 px", "usage": "Subtítulo del hero, texto destacado." },
      { "name": "base", "source": "tailwind", "family": "sans", "weight": 400, "size": "1rem", "lineHeight": "calc(1.5 / 1)", "range": "16 px", "usage": "Texto por defecto y tamaño mínimo de los campos (con menos, Safari en iPhone hace zoom)." },
      { "name": "sm", "source": "tailwind", "family": "sans", "weight": 400, "size": "0.875rem", "lineHeight": "calc(1.25 / 0.875)", "range": "14 px", "usage": "Ayudas, metadatos, botones, tablas del panel." },
      { "name": "xs", "source": "tailwind", "family": "sans", "weight": 500, "size": "0.75rem", "lineHeight": "calc(1 / 0.75)", "range": "12 px", "usage": "Insignias y marca de agua. Nada más pequeño." }
    ]
  },
  "radius": {
    "source": "nexora",
    "base": "0.5rem",
    "tokens": [
      { "name": "sm", "value": "calc(var(--radius) - 4px)", "px": 4, "usage": "Insignias y casillas." },
      { "name": "md", "value": "calc(var(--radius) - 2px)", "px": 6, "usage": "Botones y campos." },
      { "name": "lg", "value": "var(--radius)", "px": 8, "usage": "Tarjetas, imágenes dentro de tarjetas, diálogos, avisos." },
      { "name": "xl", "value": "calc(var(--radius) + 4px)", "px": 12, "usage": "Contenido de `Dialog` y `AlertDialog` (shadcn)." },
      { "name": "full", "source": "tailwind", "value": "calc(infinity * 1px)", "px": null, "usage": "Botón ▶ del video, avatar, puntos de estado, barra de `Progress`." }
    ]
  },
  "spacing": {
    "source": "tailwind",
    "unit": "0.25rem",
    "tokens": [
      { "name": "1", "value": "0.25rem", "px": 4, "usage": "Ícono con texto, insignias." },
      { "name": "2", "value": "0.5rem", "px": 8, "usage": "Ícono con texto, insignias." },
      { "name": "3", "value": "0.75rem", "px": 12, "usage": "Dentro de tarjetas, entre campo y etiqueta." },
      { "name": "4", "value": "1rem", "px": 16, "usage": "Padding de tarjeta en celular y margen lateral en celular." },
      { "name": "6", "value": "1.5rem", "px": 24, "usage": "Padding de tarjeta en escritorio, entre grupos de un formulario." },
      { "name": "8", "value": "2rem", "px": 32, "usage": "Entre bloques de una sección." },
      { "name": "12", "value": "3rem", "px": 48, "usage": "Entre bloques de una sección." },
      { "name": "16", "value": "4rem", "px": 64, "usage": "Padding vertical de sección en celular (`py-16`)." },
      { "name": "24", "value": "6rem", "px": 96, "usage": "Padding vertical de sección desde `md` (`md:py-24`)." }
    ]
  },
  "breakpoints": {
    "source": "tailwind",
    "tokens": [
      { "name": "sm", "value": "40rem", "px": 640, "usage": "Tarjetas en 2 columnas." },
      { "name": "md", "value": "48rem", "px": 768, "usage": "Revisión obligatoria. Tablas desde aquí; por debajo, lista de tarjetas." },
      { "name": "lg", "value": "64rem", "px": 1024, "usage": "Barra lateral del panel, `BuyBar` lateral." },
      { "name": "xl", "value": "80rem", "px": 1280, "usage": "Revisión obligatoria de escritorio." }
    ]
  },
  "shadow": {
    "source": "tailwind",
    "tokens": [
      { "name": "sm", "value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)", "usage": "Barra superior al hacer scroll; pestaña activa." },
      { "name": "md", "value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)", "usage": "Lista abierta de `Select`." },
      { "name": "lg", "value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)", "usage": "Elementos que flotan: `Sheet`, menús. La marca es plana: las tarjetas no llevan sombra." }
    ]
  },
  "motion": {
    "source": "tailwind",
    "tokens": [
      { "name": "duration-fast", "value": "150ms", "usage": "Color y opacidad en hover y foco (`duration-150`)." },
      { "name": "duration-base", "value": "200ms", "usage": "Acordeón, pestañas, aparición de avisos (`duration-200`)." },
      { "name": "duration-slow", "value": "300ms", "usage": "`Sheet` y diálogos (`duration-300`)." },
      { "name": "ease-out", "value": "cubic-bezier(0, 0, 0.2, 1)", "usage": "Al entrar (`ease-out`)." },
      { "name": "ease-in", "value": "cubic-bezier(0.4, 0, 1, 1)", "usage": "Al salir (`ease-in`)." },
      { "name": "ease-in-out", "value": "cubic-bezier(0.4, 0, 0.2, 1)", "usage": "Transiciones de color por defecto de Tailwind." }
    ]
  },
  "size": {
    "source": "tailwind",
    "tokens": [
      { "name": "control-sm", "value": "2.25rem", "px": 36, "usage": "`Button` y `SelectTrigger` `sm` (`h-9`): tablas del panel en escritorio. Nunca en celular." },
      { "name": "control", "value": "2.75rem", "px": 44, "usage": "Alto por defecto de botones, campos y `Select` (`h-11`); objetivo táctil mínimo." },
      { "name": "control-lg", "value": "3rem", "px": 48, "usage": "`Button` `lg` (`h-12`): botones principales del sitio y del checkout." },
      { "name": "check", "value": "1.25rem", "px": 20, "usage": "`Checkbox` y `RadioGroupItem` visibles (`size-5`), con zona táctil de 44 px." },
      { "name": "accordion-trigger", "value": "3.5rem", "px": 56, "usage": "Alto mínimo del disparador de `Accordion` (`min-h-14`)." },
      { "name": "progress", "value": "0.5rem", "px": 8, "usage": "Alto de `Progress` (`h-2`)." },
      { "name": "header", "value": "4rem", "px": 64, "usage": "Barra superior (`h-16`)." },
      { "name": "bottom-bar", "value": "4rem", "px": 64, "usage": "`BuyBar`, navegación inferior del panel y barra «Guardar día», más el área segura." },
      { "name": "icon-sm", "value": "1rem", "px": 16, "usage": "Junto a texto `sm`, dentro de insignias y botones." },
      { "name": "icon", "value": "1.25rem", "px": 20, "usage": "Botones y menús." },
      { "name": "icon-lg", "value": "1.5rem", "px": 24, "usage": "Listas de «Qué incluye», estados vacíos y de error." },
      { "name": "container", "value": "72rem", "px": 1152, "usage": "Ancho máximo del contenedor (`max-w-6xl`)." },
      { "name": "form", "value": "28rem", "px": 448, "usage": "Formularios de una columna (`max-w-md`)." }
    ]
  },
  "zIndex": {
    "source": "tailwind",
    "tokens": [
      { "name": "bottom-bar", "value": "30", "usage": "`BuyBar` y barra «Guardar día» (`z-30`)." },
      { "name": "nav", "value": "40", "usage": "Navegación inferior del panel (`z-40`)." },
      { "name": "overlay", "value": "50", "usage": "Barra superior, diálogos, `Sheet`, menús (`z-50`)." },
      { "name": "toast", "value": "100", "usage": "Avisos de `sonner` (`z-[100]`)." }
    ]
  }
}
